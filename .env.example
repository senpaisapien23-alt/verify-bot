# Copy this file to .env (same folder) and fill it in. Never commit .env.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token

# Application ID (Developer Portal -> your app -> General Information)
CLIENT_ID=your-application-id

# Guild ID for instant slash-command registration. Right-click the server
# with Developer Mode on -> Copy Server ID. Leave blank to register globally.
GUILD_ID=123456789012345678

# Set to false to skip registering slash commands on startup
REGISTER_ON_START=true

# ---- Defaults used when a server has not set its own values via /verify-role ----

# Role handed out when somebody clicks the Verify button
VERIFY_ROLE_ID=123456789012345678

# Optional channel where each successful verification is logged
VERIFY_LOG_CHANNEL_ID=

VERIFY_TITLE=Verify yourself
VERIFY_DESCRIPTION=Click the **Verify** button below to get the **Member** role and unlock the server.
VERIFY_BUTTON_LABEL=Verify
VERIFY_BUTTON_EMOJI=✅
VERIFY_COLOR=0x57f287
